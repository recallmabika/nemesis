# ==============================================================================
# NEMESIS WEB APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust the variables for your environment:
#   cp .env.example .env
# ==============================================================================

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-random-secret-key-here

# ------------------------------------------------------------------------------
# INQUIRY NOTIFICATIONS / SMTP CONFIGURATION
# ------------------------------------------------------------------------------
SMTP_HOST=mail.nemesis.co.zw
SMTP_PORT=465
SMTP_USER=info@nemesis.co.zw
SMTP_PASSWORD=your_smtp_password_here
SMTP_USE_SSL=True
SMTP_USE_TLS=False

# Destination email where inquiries should arrive
CONTACT_RECIPIENT_EMAIL=info@nemesis.co.zw

# Sender info
CONTACT_SENDER_EMAIL=info@nemesis.co.zw
CONTACT_SENDER_NAME="NEMESIS Client Inquiries"
